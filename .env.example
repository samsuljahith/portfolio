# ── Telegram notifications (recommended) ─────────────────────────────────────
# Powers visit alerts (/api/track) and contact-form delivery (/api/contact).
# Works on Render's free tier because it uses HTTPS, not SMTP.
#   1. Message @BotFather on Telegram -> /newbot -> copy the token.
#   2. Send any message to your new bot, then message @userinfobot to get your
#      numeric chat id (or open https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
TELEGRAM_CHAT_ID=123456789

# ── Optional SMTP email (secondary contact-form channel) ─────────────────────
# Render's FREE tier blocks outbound SMTP ports (25/465/587), so these only
# work on a paid plan. Telegram above is the primary channel.
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_TO=samsuljahith@gmail.com
